<!-- READING THIS FILE
     Markup describes a tree. <Name ...> begins an element; </Name> ends it.
     <Name ... /> is a complete element with no children. Nested elements belong
     to their surrounding element. Attributes such as Width="100" set properties.
     Comments cover the next element and its attributes; closing tags finish that
     same explanation. Indentation shows nesting and does not create behavior.
     See docs/ReadingTheCode.md for a worked example and the project map. -->
<!-- Describe package-manager configuration for this repository. -->
<configuration>
  <!-- NuGet normally downloads external library packages from configured sources.
       This project uses only the installed .NET SDK and project references, so
       clear inherited sources to keep restoration independent of package servers. -->
  <!-- Configure the locations from which external packages could be restored. -->
  <packageSources>
    <!-- Clear inherited package sources; this project uses SDK/framework components without external
         packages.
    -->
    <clear />
  </packageSources>
</configuration>
