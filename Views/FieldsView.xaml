<!-- READING THIS FILE
     Markup describes a tree. <Name ...> begins an element; </Name> ends it.
     <Name ... /> is a complete element with no children. Nested elements belong
     to their surrounding element. Attributes such as Width="100" set properties.
     Comments cover the next element and its attributes; closing tags finish that
     same explanation. Indentation shows nesting and does not create behavior.
     See docs/ReadingTheCode.md for a worked example and the project map. -->
<!-- Describe a reusable panel that can be placed inside a window. x:Class links this markup to the C# type
     WpfApp1.Views.FieldsView. The default xmlns identifies a family of markup names; its URI is a name,
     not a file downloaded at runtime. The xmlns:x prefix identifies a family of markup names; its URI is a
     name, not a file downloaded at runtime.
-->
<UserControl x:Class="WpfApp1.Views.FieldsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- MainWindow supplies FieldsViewModel as this panel's DataContext. These
         bindings therefore read Count, Items, and commands from that view model.
         The list gets the remaining (*) height; buttons stay below it. -->
  <!-- Draw a background or border around a child control, with optional rounded corners and inner spacing.
       Use #131A25 for Background; hexadecimal color digits describe paint, not the open file's bytes.
       Padding 15,19,12,14 adds inside spacing using the same one-, two-, or four-number order as Margin.
  -->
  <Border Background="#131A25" Padding="15,19,12,14">
    <!-- Arrange child controls in rows and columns; unspecified row or column numbers are zero. -->
    <Grid>
      <!-- Set the RowDefinitions property of Grid using the nested elements. -->
      <Grid.RowDefinitions>
        <!-- Define one row; rows are numbered from zero in their written order. Height=Auto sizes to the
             content.
        -->
        <RowDefinition Height="Auto" />
        <!-- Define one row; rows are numbered from zero in their written order. Height=Auto sizes to the
             content.
        -->
        <RowDefinition Height="Auto" />
        <!-- Define one row; rows are numbered from zero in their written order. Height=* takes a weighted
             share of the available space.
        -->
        <RowDefinition Height="*" />
        <!-- Define one row; rows are numbered from zero in their written order. Height=Auto sizes to the
             content.
        -->
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- Place children against the specified edges; by default the final child fills the remaining area.
           Set LastChildFill to False; this configures that aspect of the element.
      -->
      <DockPanel LastChildFill="False">
        <!-- Display text that the user cannot directly edit. Show the text “NAMED FIELDS”. Get Style from
             the shared resource {StaticResource SmallLabel}.
        -->
        <TextBlock Text="NAMED FIELDS" Style="{StaticResource SmallLabel}" />
        <!-- Display text that the user cannot directly edit. x:Name makes this element identifiable as
             FieldCount. Connect Text to {Binding Count}. Binding reads from DataContext unless
             RelativeSource names a different source; TwoWay sends edits back, and PropertyChanged sends
             them on each change. Dock this child against the Right edge of its DockPanel. Get Foreground
             from the shared resource {StaticResource AccentBrush}.
        -->
        <TextBlock x:Name="FieldCount" Text="{Binding Count}" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" />
      </DockPanel>
      <!-- Display text that the user cannot directly edit. Grid.Row=1 chooses that zero-based grid
           position. Show the text “Your map of the data”. Get Foreground from the shared resource
           {StaticResource MutedBrush}. Margin 0,7,0,17 adds outside spacing (one number: all sides; two:
           horizontal/vertical; four: left/top/right/bottom). Draw characters at font size 12.
      -->
      <TextBlock Grid.Row="1" Text="Your map of the data" Foreground="{StaticResource MutedBrush}" Margin="0,7,0,17" FontSize="12" />
      <!-- ObservableCollection Items notifies WPF when labels are added or
                 removed. The two-way SelectedItem binding both displays selection
                 and sends a clicked row back to the session via FieldsViewModel.
                 Gesture handlers only determine which command/row should be used. -->
      <!-- Display a list from which the user can select an item. x:Name makes this element identifiable as
           FieldList. Grid.Row=2 chooses that zero-based grid position. BorderThickness 0 sets edge widths
           (four numbers mean left/top/right/bottom). Use Transparent for Background; hexadecimal color
           digits describe paint, not the open file's bytes. Connect ItemsSource to {Binding Items}.
           Binding reads from DataContext unless RelativeSource names a different source; TwoWay sends
           edits back, and PropertyChanged sends them on each change. Connect SelectedItem to {Binding
           SelectedItem, Mode=TwoWay}. Binding reads from DataContext unless RelativeSource names a
           different source; TwoWay sends edits back, and PropertyChanged sends them on each change. When
           MouseDoubleClick occurs, run the C# handler FieldList_MouseDoubleClick. When PreviewKeyDown
           occurs, run the C# handler FieldList_PreviewKeyDown. When PreviewMouseRightButtonDown occurs,
           run the C# handler FieldList_PreviewMouseRightButtonDown. Set ContextMenuOpening to
           FieldList_ContextMenuOpening; this configures that aspect of the element. Set
           ScrollViewer.HorizontalScrollBarVisibility to Disabled; this configures that aspect of the
           element.
      -->
      <ListBox x:Name="FieldList" Grid.Row="2" BorderThickness="0" Background="Transparent" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}" MouseDoubleClick="FieldList_MouseDoubleClick" PreviewKeyDown="FieldList_PreviewKeyDown" PreviewMouseRightButtonDown="FieldList_PreviewMouseRightButtonDown" ContextMenuOpening="FieldList_ContextMenuOpening" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <!-- Menus do not inherit the regular control tree's DataContext.
                     PlacementTarget is this list, so its context supplies commands. -->
        <!-- Set the ContextMenu property of ListBox using the nested elements. -->
        <ListBox.ContextMenu>
          <!-- Describe a popup menu of actions. Connect DataContext to {Binding
               PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}. Binding reads from
               DataContext unless RelativeSource names a different source; TwoWay sends edits back, and
               PropertyChanged sends them on each change.
          -->
          <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <!-- Provide one action or submenu in the menu. Label the entry “Edit label…”. Display F2 as a
                 shortcut hint; this text alone does not implement the shortcut. Connect Command to
                 {Binding EditLabelCommand}. Binding reads from DataContext unless RelativeSource names a
                 different source; TwoWay sends edits back, and PropertyChanged sends them on each change.
            -->
            <MenuItem Header="Edit label…" InputGestureText="F2" Command="{Binding EditLabelCommand}" />
            <!-- Provide one action or submenu in the menu. Label the entry “Delete label”. Display Delete
                 as a shortcut hint; this text alone does not implement the shortcut. Connect Command to
                 {Binding DeleteLabelCommand}. Binding reads from DataContext unless RelativeSource names a
                 different source; TwoWay sends edits back, and PropertyChanged sends them on each change.
            -->
            <MenuItem Header="Delete label" InputGestureText="Delete" Command="{Binding DeleteLabelCommand}" />
          </ContextMenu>
        </ListBox.ContextMenu>
        <!-- The container is the selectable outer shell around each item.
                     A ControlTemplate defines that shell's visuals. ContentPresenter
                     inserts the item content described by ItemTemplate below. -->
        <!-- Set the ItemContainerStyle property of ListBox using the nested elements. -->
        <ListBox.ItemContainerStyle>
          <!-- Group property settings that can be reused by controls. Apply this description to
               ListBoxItem controls.
          -->
          <Style TargetType="ListBoxItem">
            <!-- Supply a property setting for the surrounding style or trigger. The property being
                 configured or tested is HorizontalContentAlignment. Use Stretch as the setting or
                 comparison value.
            -->
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <!-- Supply a property setting for the surrounding style or trigger. The property being
                 configured or tested is Margin. Use 0,0,0,7 as the setting or comparison value.
            -->
            <Setter Property="Margin" Value="0,0,0,7" />
            <!-- Supply a property setting for the surrounding style or trigger. The property being
                 configured or tested is Padding. Use 0 as the setting or comparison value.
            -->
            <Setter Property="Padding" Value="0" />
            <!-- Supply a property setting for the surrounding style or trigger. The property being
                 configured or tested is Template.
            -->
            <Setter Property="Template">
              <!-- Set the Value property of Setter using the nested elements. -->
              <Setter.Value>
                <!-- Describe the visual pieces used to draw a control. Apply this description to
                     ListBoxItem controls.
                -->
                <ControlTemplate TargetType="ListBoxItem">
                  <!-- Draw a background or border around a child control, with optional rounded corners
                       and inner spacing. x:Name makes this element identifiable as ItemBorder. Use #192230
                       for Background; hexadecimal color digits describe paint, not the open file's bytes.
                       Use #253242 for BorderBrush; hexadecimal color digits describe paint, not the open
                       file's bytes. BorderThickness 1 sets edge widths (four numbers mean
                       left/top/right/bottom). CornerRadius 7 rounds the corners. Padding 11 adds inside
                       spacing using the same one-, two-, or four-number order as Margin.
                  -->
                  <Border x:Name="ItemBorder" Background="#192230" BorderBrush="#253242" BorderThickness="1" CornerRadius="7" Padding="11">
                    <!-- Display the content supplied by the surrounding control or template. -->
                    <ContentPresenter />
                  </Border>
                  <!-- These triggers inspect control state, unlike
                                         a DataTrigger that inspects view-model data. -->
                  <!-- Set the Triggers property of ControlTemplate using the nested elements. -->
                  <ControlTemplate.Triggers>
                    <!-- Apply the nested settings when the specified control Property equals Value. The
                         property being configured or tested is IsSelected. Use True as the setting or
                         comparison value.
                    -->
                    <Trigger Property="IsSelected" Value="True">
                      <!-- Supply a property setting for the surrounding style or trigger. Apply this
                           setter to the template element named ItemBorder. The property being configured
                           or tested is Background. Use #193536 as the setting or comparison value.
                      -->
                      <Setter TargetName="ItemBorder" Property="Background" Value="#193536" />
                      <!-- Supply a property setting for the surrounding style or trigger. Apply this
                           setter to the template element named ItemBorder. The property being configured
                           or tested is BorderBrush. Use #4FAF9E as the setting or comparison value.
                      -->
                      <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4FAF9E" />
                    </Trigger>
                    <!-- Apply the nested settings when the specified control Property equals Value. The
                         property being configured or tested is IsMouseOver. Use True as the setting or
                         comparison value.
                    -->
                    <Trigger Property="IsMouseOver" Value="True">
                      <!-- Supply a property setting for the surrounding style or trigger. Apply this
                           setter to the template element named ItemBorder. The property being configured
                           or tested is BorderBrush. Use #617385 as the setting or comparison value.
                      -->
                      <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#617385" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </ListBox.ItemContainerStyle>
        <!-- WPF repeats this template for each FieldItemViewModel; inside
                     it, Name/Color/Value refer to that item, not the whole panel.
                     WPF converts the Color string (such as #54BFA6) into a brush. -->
        <!-- Set the ItemTemplate property of ListBox using the nested elements. -->
        <ListBox.ItemTemplate>
          <!-- Describe how one data item should appear on screen. -->
          <DataTemplate>
            <!-- Place child controls one after another; the default direction is vertical. -->
            <StackPanel>
              <!-- Place children against the specified edges; by default the final child fills the
                   remaining area.
              -->
              <DockPanel>
                <!-- Supply the Ellipse setting using the contents below. Connect Fill to {Binding Color}.
                     Binding reads from DataContext unless RelativeSource names a different source; TwoWay
                     sends edits back, and PropertyChanged sends them on each change. Width=7 requests that
                     size in WPF layout units (independent of monitor pixel density). Height=7 requests
                     that size in WPF layout units (independent of monitor pixel density). Margin 0,0,8,0
                     adds outside spacing (one number: all sides; two: horizontal/vertical; four:
                     left/top/right/bottom).
                -->
                <Ellipse Fill="{Binding Color}" Width="7" Height="7" Margin="0,0,8,0" />
                <!-- Display text that the user cannot directly edit. Connect Text to {Binding Name}.
                     Binding reads from DataContext unless RelativeSource names a different source; TwoWay
                     sends edits back, and PropertyChanged sends them on each change. Get Foreground from
                     the shared resource {StaticResource TextBrush}. Use SemiBold text weight.
                     TextTrimming=CharacterEllipsis specifies how text that cannot fit is shortened.
                -->
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <!-- Display text that the user cannot directly edit. Connect Text to {Binding Details}.
                   Binding reads from DataContext unless RelativeSource names a different source; TwoWay
                   sends edits back, and PropertyChanged sends them on each change. Get Foreground from the
                   shared resource {StaticResource MutedBrush}. Margin 15,5,0,0 adds outside spacing (one
                   number: all sides; two: horizontal/vertical; four: left/top/right/bottom). Draw
                   characters at font size 11. TextWrapping=Wrap controls whether long text continues on
                   another line.
              -->
              <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" Margin="15,5,0,0" FontSize="11" TextWrapping="Wrap" />
              <!-- Display text that the user cannot directly edit. Connect Text to {Binding Value}.
                   Binding reads from DataContext unless RelativeSource names a different source; TwoWay
                   sends edits back, and PropertyChanged sends them on each change. Get Foreground from the
                   shared resource {StaticResource TextBrush}. Margin 15,6,0,0 adds outside spacing (one
                   number: all sides; two: horizontal/vertical; four: left/top/right/bottom). Draw
                   characters at font size 12. Use the Consolas typeface. TextTrimming=CharacterEllipsis
                   specifies how text that cannot fit is shortened.
              -->
              <TextBlock Text="{Binding Value}" Foreground="{StaticResource TextBrush}" Margin="15,6,0,0" FontSize="12" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <!-- All entry points use the same commands, so toolbar buttons and
                 context-menu actions share availability, validation, and undo. -->
      <!-- Place child controls one after another; the default direction is vertical. Grid.Row=3 chooses
           that zero-based grid position. Margin 0,12,0,0 adds outside spacing (one number: all sides; two:
           horizontal/vertical; four: left/top/right/bottom).
      -->
      <StackPanel Grid.Row="3" Margin="0,12,0,0">
        <!-- Arrange child controls in rows and columns; unspecified row or column numbers are zero. Margin
             0,0,0,8 adds outside spacing (one number: all sides; two: horizontal/vertical; four:
             left/top/right/bottom).
        -->
        <Grid Margin="0,0,0,8">
          <!-- Set the ColumnDefinitions property of Grid using the nested elements. -->
          <Grid.ColumnDefinitions>
            <!-- Define one column; columns are numbered from zero in their written order. Width=* takes a
                 weighted share of the available space.
            -->
            <ColumnDefinition Width="*" />
            <!-- Define one column; columns are numbered from zero in their written order. Width=8 requests
                 that size in WPF layout units (independent of monitor pixel density).
            -->
            <ColumnDefinition Width="8" />
            <!-- Define one column; columns are numbered from zero in their written order. Width=* takes a
                 weighted share of the available space.
            -->
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <!-- Provide a clickable button. x:Name makes this element identifiable as EditLabelButton. Use
               “Edit label…” as the displayed content. Connect Command to {Binding EditLabelCommand}.
               Binding reads from DataContext unless RelativeSource names a different source; TwoWay sends
               edits back, and PropertyChanged sends them on each change. Padding 6,7 adds inside spacing
               using the same one-, two-, or four-number order as Margin. Show “Edit the selected label,
               color, notes, and source bits (F2)” when the pointer rests over this control.
          -->
          <Button x:Name="EditLabelButton" Content="Edit label…" Command="{Binding EditLabelCommand}" Padding="6,7" ToolTip="Edit the selected label, color, notes, and source bits (F2)" />
          <!-- Provide a clickable button. x:Name makes this element identifiable as DeleteLabelButton.
               Grid.Column=2 chooses that zero-based grid position. Use “Delete label” as the displayed
               content. Connect Command to {Binding DeleteLabelCommand}. Binding reads from DataContext
               unless RelativeSource names a different source; TwoWay sends edits back, and PropertyChanged
               sends them on each change. Padding 6,7 adds inside spacing using the same one-, two-, or
               four-number order as Margin. Show “Delete the selected label; preserves data. Ctrl+Z
               restores it.” when the pointer rests over this control.
          -->
          <Button x:Name="DeleteLabelButton" Grid.Column="2" Content="Delete label" Command="{Binding DeleteLabelCommand}" Padding="6,7" ToolTip="Delete the selected label; preserves data. Ctrl+Z restores it." />
        </Grid>
        <!-- Provide a clickable button. Use “+ Label selection” as the displayed content. Connect Command
             to {Binding AddLabelCommand}. Binding reads from DataContext unless RelativeSource names a
             different source; TwoWay sends edits back, and PropertyChanged sends them on each change. Get
             Style from the shared resource {StaticResource AccentButton}.
        -->
        <Button Content="+  Label selection" Command="{Binding AddLabelCommand}" Style="{StaticResource AccentButton}" />
        <!-- Display text that the user cannot directly edit. Show the text “Double-click a label to edit
             it. Right-click for more actions.”. Get Foreground from the shared resource {StaticResource
             MutedBrush}. TextWrapping=Wrap controls whether long text continues on another line. Draw
             characters at font size 11. Margin 2,10,2,0 adds outside spacing (one number: all sides; two:
             horizontal/vertical; four: left/top/right/bottom).
        -->
        <TextBlock Text="Double-click a label to edit it. Right-click for more actions." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="2,10,2,0" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
